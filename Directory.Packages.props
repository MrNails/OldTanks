<Project>

    <!-- Central package management: every NuGet version in the solution is set here once;
         project files list their packages without a Version. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Engine and game -->
    <ItemGroup>
        <PackageVersion Include="FreeTypeSharp" Version="3.1.0" />
        <PackageVersion Include="ImGui.NET" Version="1.91.6.1" />
        <PackageVersion Include="OpenTK" Version="4.9.4" />
        <PackageVersion Include="Serilog" Version="4.4.0" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.3" />
    </ItemGroup>

    <!-- Source generator. Roslyn is held at the compiler version of the .NET SDK that builds the solution
         (SDK 10.0.401 ships Roslyn 5.9.0): a generator compiled against a newer Microsoft.CodeAnalysis
         does not load in an older compiler (CS9057). Raise it together with the SDK. -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    </ItemGroup>

    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageVersion Include="NUnit" Version="5.0.0" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    </ItemGroup>

</Project>
